# Core application (no model key required)
DATABASE_URL=sqlite:///data/education_scheduling.db
DB_ECHO=false
SESSION_TTL_SECONDS=1800
AUTO_INIT_DB=true
SEED_DEMO_DATA=true

# Optional chat-model enhancement
MODEL_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional semantic knowledge/teacher matching enhancement
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
